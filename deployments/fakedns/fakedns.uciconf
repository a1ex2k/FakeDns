config fakedns 'main'
	option enabled '1'
	option domains '/etc/fakedns/fake-domains.list'
	option listen '127.0.0.1'
	option port '50053'
	option catch_all_port '0'
	option fwmark '0x80000000'
	option upstream '1.1.1.1:53'
	option fake4 '198.18.0.0/15'
	option fake6 'abcd:bad:c0de::/64'
	option autoreload '1'