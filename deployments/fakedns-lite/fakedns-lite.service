[Unit]
Description=FakeDNS server
After=network.target nftables.service
Requires=nftables.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/fakedns-lite \
    --listen=127.0.0.1 \
    --listener=50053@0x80000000 \
    --fake4=198.18.0.0/15 \
    --fake6=abcd:bad:c0de::/64 \
    --upstream=1.1.1.1:53
ExecReload=/usr/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
