[Unit]
Description=FakeDNS WebUI
After=network.target fakedns.service
Requires=fakedns.service

[Service]
Type=simple
User=root
WorkingDirectory=/usr/bin
ExecStart=/usr/bin/fakedns-webui \
  -listen="127.0.0.1:8484" \
  -domains="/etc/fakedns/fake-domains.list" \
  -service="fakedns.service"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
