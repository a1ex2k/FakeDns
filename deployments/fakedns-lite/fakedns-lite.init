#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

# This function reads the UCI config and starts the process
start_instance() {
    local section="$1"
    local listen listeners upstream enabled fake4 fake6 workers

    # Read values from /etc/config/fakedns-lite
    config_get_bool enabled "$section" 'enabled' 0
    [ "$enabled" -eq 0 ] && return

    config_get listen "$section" 'listen' '127.0.0.1'
    config_get listeners "$section" 'listeners' '50053@0x80000000'
    config_get upstream "$section" 'upstream' '8.8.8.8:53'
    config_get fake4 "$section" 'fake4' '198.18.0.0/15'
    config_get fake6 "$section" 'fake6' 'abcd:bad:c0de::/64'
    config_get workers "$section" 'workers' '0'

    procd_open_instance "main"
    procd_set_param command /usr/bin/fakedns-lite
    
    # Append arguments
    procd_append_param command --listen "$listen"
    procd_append_param command --upstream "$upstream"
    procd_append_param command --fake4 "$fake4"
    procd_append_param command --fake6 "$fake6"

    local oldifs="$IFS"
    IFS=','
    for listener in $listeners; do
        listener="$(echo "$listener" | tr -d '[:space:]')"
        [ -n "$listener" ] && procd_append_param command --listener "$listener"
    done
    IFS="$oldifs"

    if [ -n "$workers" ] && [ "$workers" != "0" ]; then
        procd_append_param command --workers "$workers"
    fi

    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param user root
    procd_close_instance
}

start_service() {
    config_load "fakedns-lite"
    config_foreach start_instance 'fakedns_lite'
}

service_triggers() {
    # This makes the service restart automatically if /etc/config/fakedns-lite is changed
    procd_add_reload_trigger "fakedns-lite"
}

reload_service() { restart; }
