[Unit]
Description=FakeDNS WebUI
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/fakedns-webui \
  --listen=127.0.0.1:8484 \
  --domains=/etc/fakedns/fake-domains.list \
  --service=fakedns.service \
  --no-auth=false
Restart=on-failure
RestartPreventExitStatus=3
RestartSec=5

[Install]
WantedBy=multi-user.target
