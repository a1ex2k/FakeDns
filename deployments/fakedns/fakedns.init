#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

# This function reads the UCI config and starts the process
start_instance() {
    local section="$1"
    local domains listen port catch_all_port fwmark upstream enabled

    # Read values from /etc/config/fakedns
    config_get_bool enabled "$section" 'enabled' 0
    [ "$enabled" -eq 0 ] && return

    config_get domains "$section" 'domains' '/etc/fakedns/fake-domains.list'
    config_get listen "$section" 'listen' '127.0.0.1'
    config_get port "$section" 'port' '50053'
    config_get catch_all_port "$section" 'catch_all_port' '0'
    config_get fwmark "$section" 'fwmark' '0x80000000'
    config_get upstream "$section" 'upstream' '8.8.8.8:53'

    procd_open_instance "main"
    procd_set_param command /usr/bin/fakedns
    
    # Append arguments
    procd_append_param command --domains "$domains"
    procd_append_param command --listen "$listen"
    procd_append_param command --port "$port"
    procd_append_param command --fwmark "$fwmark"
    procd_append_param command --upstream "$upstream"

    # Only add catch-all if a port is specified (greater than 0)
    if [ "$catch_all_port" -gt 0 ]; then
        procd_append_param command --catch-all-port "$catch_all_port"
    fi

    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param user root
    procd_close_instance
}

start_service() {
    config_load fakedns
    config_foreach start_instance 'fakedns'
}

service_triggers() {
    # This makes the service restart automatically if /etc/config/fakedns is changed
    procd_add_reload_trigger "fakedns"
}

reload_service() {
    # If the process handles SIGHUP to reload domain lists without restart
    procd_send_signal fakedns "main" SIGHUP
}